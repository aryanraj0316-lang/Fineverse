# dependencies (any depth, so reference-project/node_modules is covered too)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing and visual QA output (regenerate with `npm run qa`)
/coverage
/test-results/
/playwright-report/
/qa/screenshots/
/qa/lighthouse/

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude Code permissions
.claude/settings.local.json
